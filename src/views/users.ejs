<%- include('partials/head') %>
<div id="usersPage"></div>
<div class="page-head"><h1>Usuarios</h1></div>
<div class="card">
  <h2>Agregar usuario</h2>
  <form id="userForm" class="grid grid-4" style="align-items:end">
    <div><label>Nombre</label><input type="text" name="fullName" required></div>
    <div><label>Correo</label><input type="email" name="email" required></div>
    <div><label>Contraseña inicial</label><input type="text" name="password" required minlength="8" placeholder="Mínimo 8 caracteres"></div>
    <div class="row"><select name="role" style="flex:1"><option value="Empleado">Equipo</option><option value="Administrador">Administrador</option></select><button class="btn btn-primary" type="submit">Agregar</button></div>
  </form>
  <div class="form-error" id="userFormError"></div>
  <div class="help">El equipo puede revisar y mover oportunidades. Los administradores además gestionan fuentes, palabras clave y usuarios.</div>
</div>
<div class="card" style="padding:6px 8px">
  <table class="table">
    <thead><tr><th>Activo</th><th>Nombre</th><th>Correo</th><th>Rol</th><th></th></tr></thead>
    <tbody>
    <% users.forEach(u => { %>
      <tr>
        <td><label class="switch"><input type="checkbox" data-user="<%= u.Id %>" data-field="active" <%= u.IsActive ? 'checked' : '' %>><span></span></label></td>
        <td><b><%= u.FullName %></b><%= u.Id === user.id ? ' (tú)' : '' %></td>
        <td><%= u.Email %></td>
        <td><select data-user="<%= u.Id %>" data-field="role" style="width:auto"><option value="Empleado" <%= u.RoleName !== 'Administrador' ? 'selected' : '' %>>Equipo</option><option value="Administrador" <%= u.RoleName === 'Administrador' ? 'selected' : '' %>>Administrador</option></select></td>
        <td style="text-align:right"><button class="btn btn-sm btn-ghost" type="button" data-user-reset="<%= u.Id %>" data-name="<%= u.FullName %>">Cambiar contraseña</button></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/foot') %>

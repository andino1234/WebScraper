{
  "name": "licitaciones-insight",
  "version": "2.0.0",
  "description": "Monitor de licitaciones y consultorías para Centroamérica, el Caribe, México, Estados Unidos y Brasil",
  "author": "Ariel Geovanny Andino Chinchilla (https://github.com/andino1234)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "scrape": "node src/engine/cli.js",
    "scrape:source": "node src/engine/cli.js --source",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "winston": "^3.13.0"
  },
  "optionalDependencies": {
    "puppeteer": "^25.17.0"
  }
}

# ============================================================
#  Licitaciones Insight Latam v2 — configuración
#  Copia este archivo como .env y completa los valores.
#  Si vienes de la versión anterior, puedes reutilizar tu .env:
#  los nombres DB_SERVER / DB_USER / DB_PASSWORD / DB_DATABASE / JWT_SECRET siguen funcionando.
# ============================================================

NODE_ENV=production
PORT=3001
BASE_URL=https://webscraper.insightlatam.com

# Cadena larga y aleatoria (si ya tenías una, conserva la misma)
JWT_SECRET=

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=webscrip

# Usuario administrador inicial (solo se crea si no hay ningún usuario)
DEFAULT_ADMIN_EMAIL=admin@insightlatam.com
DEFAULT_ADMIN_PASSWORD=

# ---------- Búsqueda ----------
# Zona horaria del programador y hora (0-23) de la búsqueda completa diaria
TZ_SCHEDULER=America/Guatemala
SCRAPE_DAILY_HOUR=5
# Puntaje mínimo para guardar una oportunidad (25 = al menos una palabra relevante)
MIN_SCORE=25
# Exigir al menos una palabra clave en el TÍTULO (true recomendado)
REQUIRE_KEYWORD_IN_TITLE=true
# Guardar convocatorias aunque no se detecte la fecha límite (true/false)
KEEP_WITHOUT_DEADLINE=true
# Incluir avisos regionales (Centroamérica, Caribe, Latinoamérica) además de los de un país concreto
INCLUDE_REGIONAL=true
# Clave gratuita de SAM.gov (contratos federales de EE. UU.). Opcional.
SAM_API_KEY=
# Ruta de Chrome para fuentes que necesitan navegador (portales hechos con JavaScript). Opcional.
CHROME_PATH=

# ---------- Alertas (opcionales) ----------
# Resumen de oportunidades de prioridad Alta/Crítica después de cada búsqueda
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# Sitios que pueden mostrar la app dentro de un iframe (Portal Insight Latam / Teams)
# FRAME_ANCESTORS='self' https://portal.insightlatam.com https://teams.microsoft.com https://*.teams.microsoft.com
